<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.VehicleDetails"
             Title="VehicleDetails">
    <VerticalStackLayout>
        <Button Text="Delete Vehicle" Clicked="OnButtonDeleteClicked" WidthRequest="400"/>
        <Button Text="Edit Vehicle Name" Clicked="OnButtonEditClicked" WidthRequest="400" />
        <Label x:Name="infoLabel" IsVisible="False" Text="Vehicle name:" HorizontalTextAlignment="Center"/>
        <Label x:Name="infoLabelnew" IsVisible="False" Text="Enter valid name" HorizontalTextAlignment="Center"/>
        <Entry x:Name="vehicleName" IsVisible="False" WidthRequest="400"/>
        <Button x:Name="SaveName" Text="SaveName" IsVisible="False" Clicked="OnButtonSaveClicked" WidthRequest="400" />
    </VerticalStackLayout>
</ContentPage>