<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Bookings"
             Title="Bookings">
    <VerticalStackLayout>

        <StackLayout>
            <ListView x:Name="myBookingsListView" WidthRequest="1000" ItemSelected="OnBookingSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        
                        <ViewCell>
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Label Text="{Binding Id}" Grid.Column="0" HorizontalOptions="FillAndExpand"/>
                                <Label Text="{Binding car.Name}" Grid.Column="1" HorizontalOptions="FillAndExpand"/>
                                <Label Text="{Binding driver}" Grid.Column="2" HorizontalOptions="FillAndExpand"/>
                                <Label Text="{Binding start}" Grid.Column="3" HorizontalOptions="FillAndExpand"/>
                                <Label Text="{Binding end}" Grid.Column="4" HorizontalOptions="FillAndExpand"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackLayout>

                <Button Text="Add Booking" Clicked="OnAddItemClicked" WidthRequest="200"/>
            </StackLayout>

        </StackLayout>
    </VerticalStackLayout>
</ContentPage>