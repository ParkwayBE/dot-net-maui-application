<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.AddVehicle"
             Title="AddVehicle">
    <VerticalStackLayout>
        <StackLayout>
            <Label Text="Name:" WidthRequest="200"/>
            <Entry x:Name="nameEntry" WidthRequest="200"/>
            <Button Text="Add Vehicle" Clicked="OnAddItemClicked" WidthRequest="200"/>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>